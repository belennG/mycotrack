# Copy to backend/.env. The defaults below match `docker compose up -d db` (docker-compose.yml)
# and are enough to run the API and its tests locally.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mycotrack

# For a hosted database (e.g. AWS RDS), set DB_HOST / DB_PASSWORD / DB_NAME to its values, or
# give a full connection string instead, which takes precedence over the DB_* settings:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional error reporting; leave empty to disable.
SENTRY_DSN=

# --- Auth0 (see docs/auth0.md) ---
# Every /api/v1 route requires an Auth0 access token, so the API answers 401 until these are set.
# The Auth0 tenant domain, e.g. mycotrack-dev.eu.auth0.com
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# The API "Identifier" configured in Auth0 (this is the token audience)
AUTH0_API_AUDIENCE=https://api.mycotrack.app
# Namespace for the custom claims added by the Auth0 post-login Action
AUTH0_CLAIM_NAMESPACE=https://mycotrack.app/
# Optional overrides (sensible defaults derived from AUTH0_DOMAIN):
# AUTH0_ISSUER=https://your-tenant.eu.auth0.com/
# AUTH0_ALGORITHMS=RS256
